node_modules/
dist/
.vite/
*.log
screenshots/_scratch/

# Snow-Burgers source assets: 176 MB of supplied GLBs. Preserved locally and
# hashed in art/source-assets/snow-burgers/IMPORT_AUDIT.json; deliberately not
# committed, because this repository publishes to GitHub Pages and a binary of
# that size is permanent in its history.
art/source-assets/snow-burgers/*.glb
# Decimation sweep candidates: evidence, reproducible from optimize-assets.mjs.
screenshots/snow-burgers/sweep/*.glb

art/source-assets/snow-burgers/*-source.glb

# Big Air Basin venue sources: the raw Sketchfab downloads. Preserved locally
# and hashed in art/source-assets/big-air/meta/*.json and in ASSETS.md; kept
# out of git for the same reason as the snow-burgers sources — this repository
# publishes to GitHub Pages and binaries are permanent in its history. The
# runtime derivatives under public/assets/models/big-air/ ARE committed.
art/source-assets/big-air/*.glb
art/source-assets/big-air/*.zip
