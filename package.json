{
  "name": "snow-burgers",
  "version": "1.0.0",
  "description": "Snowboarding game: ride the mountain, collect giant burger ingredients, build the order at the grill. Built on the KAKISNOW real-time procedural snow renderer (Babylon.js / WebGPU)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "validate:release": "node tools/validate-release.mjs",
    "validate:release:report": "node tools/validate-release.mjs --report-only",
    "validate:registry": "node tools/validate-release.mjs --check registry",
    "validate:assets": "node tools/validate-release.mjs --check assets",
    "validate:docs": "node tools/validate-release.mjs --check docs",
    "smoke:browser": "node tools/smoke-browser.mjs"
  },
  "keywords": [
    "game",
    "snowboarding",
    "snow-burgers",
    "kakisnow",
    "webgpu",
    "babylonjs",
    "wgsl",
    "snow",
    "terrain",
    "procedural",
    "graphics"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@babylonjs/core": "9.18.1",
    "@babylonjs/loaders": "9.18.1",
    "@babylonjs/materials": "9.18.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.62.0",
    "vite": "8.1.5"
  }
}
